+std::size_t MinPerformanceCoresForPinning() {
+    static const std::size_t threshold = [] {
+        const char* text = std::getenv("EDEN_NX2_MIN_PIN_CORES");
+        if (text == nullptr) {
+            return MinCoresForGpuThreadPinning;
+        }
+        char* end = nullptr;
+        const unsigned long parsed = std::strtoul(text, &end, 10);
+        if (end == text || parsed == 0) {
+            return MinCoresForGpuThreadPinning;
+        }
+        return static_cast<std::size_t>(parsed);
+    }();
+    return threshold;
+}
